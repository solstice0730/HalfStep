PROJECT_NAME=HalfStep API
ENVIRONMENT=local
API_PREFIX=/api

BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8081

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=halfstep
MYSQL_PASSWORD=halfstep
MYSQL_DATABASE=halfstep

DATABASE_URL=mysql+pymysql://halfstep:halfstep@localhost:3306/halfstep

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
OAUTH_DEV_TOKENS_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# LLM: auto(기본, Gemini 우선) | gemini | openai | none
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OpenAI 호환용 (선택)
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_FALLBACK_ENABLED=true
# 일기 생성 모델 실패 시 503으로 재시도 유도(false) / 규칙 기반 초안으로 대체(true)
AI_DIARY_FALLBACK_ON_ERROR=false

UPLOAD_DIR=/app/uploads
