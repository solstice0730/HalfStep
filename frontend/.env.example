API_BASE_URL=http://localhost:8000/api
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api
# Native provider consoles must register the public HTTPS callbacks below:
# {EXPO_PUBLIC_API_BASE_URL}/auth/{google|kakao|naver}/callback
# The backend relays the result to halfstep://login. Keep provider secrets in backend/.env only.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_KAKAO_REST_API_KEY=
EXPO_PUBLIC_NAVER_CLIENT_ID=
