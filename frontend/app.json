{
  "expo": {
    "name": "반걸음",
    "slug": "halfstep",
    "version": "0.1.0",
    "icon": "./assets/images/app-icon.png",
    "orientation": "portrait",
    "scheme": "halfstep",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "오늘의 순간을 사진으로 기록하기 위해 카메라 접근 권한이 필요합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "일기에 사진을 추가하기 위해 사진 보관함 접근 권한이 필요합니다."
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8F3",
          "image": "./assets/images/app-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.solstice0730.halfstep",
      "icon": "./assets/images/app-icon.png",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF7EC"
      }
    },
    "extra": {
      "eas": {
        "projectId": "b3a8d196-94fc-449d-aef1-b6694d15d331"
      }
    },
    "owner": "solstice0730"
  }
}
