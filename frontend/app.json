{
  "expo": {
    "name": "HalfStep",
    "slug": "halfstep",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "halfstep",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "오늘의 순간을 사진으로 기록하기 위해 카메라 접근 권한이 필요합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "일기에 사진을 추가하기 위해 사진 보관함 접근 권한이 필요합니다."
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.solstice0730.halfstep",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF7EC"
      }
    }
  }
}
